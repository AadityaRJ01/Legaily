# Legaily Doc AI — copy to .env and fill in your keys

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API keys
COHERE_API_KEY=your_cohere_api_key
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_RERANK_MODEL=rerank-english-v3.0
SLRE_RERANK_MODEL=rerank-v3.5
SLRE_EXPAND_MODEL=command-r7b-12-2024
GOOGLE_API_KEY=
HF_TOKEN=

# Paths (optional — defaults are project-relative)
# LEGAILY_DATA_DIR=
# LEGAILY_STATUTES_INDEX_DIR=
# LEGAILY_LOGS_DIR=

# RAG / FAISS
EMBEDDING_MODEL=law-ai/InLegalBERT
QA_FULL_CONTEXT_LIMIT=80000
QA_CHUNK_SIZE=400
QA_CHUNK_OVERLAP=120
QA_RETRIEVE_K=30
QA_RERANK_TOP_N=12
QA_TEMPERATURE=0.1
INGEST_CHUNK_SIZE=1200
INGEST_CHUNK_OVERLAP=200
SLRE_FAISS_K=10
SLRE_RERANK_TOP_N=8

# Summarization
SUMMARY_MAX_CHARS=20000
